# Cesium Ion access token for 3D World Terrain elevation meshes & aerial imagery
VITE_CESIUM_ION_TOKEN=your_cesium_ion_token_here

# CARTO Basemaps API key
VITE_CARTO_API_KEY=your_carto_api_key_here

# NASA Earthdata Login (EDL) Bearer Token for live ASF CMR search & NISAR cloud assets
VITE_EARTHDATA_TOKEN=your_nasa_earthdata_jwt_token_here
EARTHDATA_TOKEN=your_nasa_earthdata_jwt_token_here

# Supabase Backend (PostgreSQL / PostGIS + Storage CDN + Mission Watchpoints)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
